# =============================================================================
# HBG LABS CLIENT PLATFORM — Variables d'environnement (§37)
# =============================================================================
# Copiez ce fichier vers `.env` et renseignez les valeurs.
# `.env` est ignoré par git (voir .gitignore). NE JAMAIS committer de valeurs.
#
# RÈGLE DE SÉCURITÉ ABSOLUE (§36) :
#   - Tout ce qui est préfixé VITE_ est EMBARQUÉ DANS LE BUNDLE JAVASCRIPT
#     et donc PUBLIC. Lisible par n'importe quel visiteur.
#   - Tout le reste est SERVEUR UNIQUEMENT (Edge Functions Supabase, Vercel
#     Environment Variables). Ne JAMAIS préfixer un secret par VITE_.
#
# Le script `scripts/check-bundle-secrets.mjs` (exécuté au build) échoue
# si un secret se retrouve dans dist/.
# =============================================================================


# -----------------------------------------------------------------------------
# CLIENT — public, embarqué dans le bundle
# -----------------------------------------------------------------------------

# URL du projet Supabase. Dashboard Supabase > Project Settings > Data API
VITE_SUPABASE_URL=

# Clé anonyme (publishable). Conçue pour être publique : toute la sécurité
# repose sur les policies RLS, jamais sur le secret de cette clé.
# Dashboard Supabase > Project Settings > API Keys > anon / public
VITE_SUPABASE_ANON_KEY=

# Environnement applicatif : development | staging | production (§48)
VITE_APP_ENV=development

# URL publique de l'application (liens de redirection auth, emails, canonical SEO)
VITE_APP_URL=http://localhost:5173

# DSN Sentry côté navigateur (§17). Optionnel — laisser vide désactive Sentry.
VITE_SENTRY_DSN=


# -----------------------------------------------------------------------------
# SERVEUR — SECRET. Jamais de préfixe VITE_. Jamais dans le navigateur.
# -----------------------------------------------------------------------------
# Ces variables ne sont PAS lues par Vite. Elles sont consommées par :
#   - les Edge Functions Supabase (`supabase secrets set`)
#   - les tests RLS locaux (tests/rls/, lecture via .env)
#   - Vercel (Project Settings > Environment Variables)

# Clé service_role Supabase : CONTOURNE TOUTES LES POLICIES RLS.
# Compromission = accès total à toutes les données de tous les clients.
# Dashboard Supabase > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Référence du projet Supabase (le sous-domaine de VITE_SUPABASE_URL)
SUPABASE_PROJECT_REF=

# Stripe — utiliser IMPÉRATIVEMENT les clés de TEST (sk_test_...) tant que la
# plateforme n'est pas validée en production (§48, §49).
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe (whsec_...). Obtenu à la création du
# endpoint webhook. Obligatoire : toute requête webhook non signée est rejetée (§21).
STRIPE_WEBHOOK_SECRET=

# Vercel — pour la gestion des projets et domaines clients (§33)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Resend — emails transactionnels (§26)
RESEND_API_KEY=

# Sentry côté serveur (§17)
SENTRY_DSN=
